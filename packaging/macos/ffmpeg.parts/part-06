pred[x + y*8] = x264_clip_pixel( pix >> 5 );
pix += b;
}
i00 += c;
}
satd = satd_8x4_lp( src, src_stride, pred, 8 );
for( int y = 0; y < 4; y++ )
{
int pix = i00;
for( int x = 0; x < 8; x++ )
{
pred[x + y*8] = x264_clip_pixel( pix >> 5 );
pix += b;
}
i00 += c;
