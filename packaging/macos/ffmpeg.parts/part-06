pr0.s2 = ( 2 + top[6] + 2*top[7] + top[8] ) >> 2;
pr0.s3 = ( 2 + top[7] + 2*top[8] + top[9] ) >> 2;
pr0.s4 = ( 2 + top[8] + 2*top[9] + top[10] ) >> 2;
