pr1.s6 = pr3.s7 = F2( top[4], top[5], top[6] );
pr0.s6 = pr2.s7 = F1( top[5], top[6] );
pr1.s7 = F2( top[5], top[6], top[7] );
pr0.s7 = F1( top[6], top[7] );
